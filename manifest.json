{
  "manifest_version": 3,
  "name": "Speed Controller",
  "description": "Change the playback speed of any page!",
  "version": "1.0",
  "action": {
    "default_popup": "popup.html",
    "default_icon": "speedometer.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}